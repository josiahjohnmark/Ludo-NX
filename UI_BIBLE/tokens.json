{
  "$meta": {
    "name": "Ludo NX UI tokens",
    "version": "1.0.0-proposal",
    "date": "2026-09-26",
    "rules": "Read LUDO_NX_UI_BIBLE.md first. Use only these values. Sizes are points in the 440 x 956 design frame. Unity units = pt x 2.4545 (canvas 1080 wide).",
    "frame": { "width": 440, "height": 956, "export": "@3x", "unityUnitsPerPt": 2.4545 }
  },

  "color": {
    "ground": {
      "base":  { "hex": "#1E2229", "use": "letterbox and fallback behind bg_menu_emboss" },
      "deep":  { "hex": "#14171C", "use": "vignette edges" },
      "match": { "hex": "#162B3C", "use": "behind the board during a match" },
      "scrim": { "hex": "#0B0D12", "alpha": 0.72, "use": "behind every popup" }
    },
    "surface": {
      "cream50":  { "hex": "#FBF4E6", "use": "lit or selected row, highlights" },
      "cream100": { "hex": "#F3E4C9", "use": "panel rim, rows, text on dark ground" },
      "tan200":   { "hex": "#CFAE84", "use": "panel field" },
      "tan300":   { "hex": "#C09666", "use": "wells, bottom nav plate, row lips, inactive tabs" },
      "tan400":   { "hex": "#A27E57", "use": "hairlines, dividers, field outline" },
      "brown600": { "hex": "#7A5E40", "use": "corner dice, line icons on tan" },
      "brown700": { "hex": "#5A4227", "use": "nameplate body" },
      "brown800": { "hex": "#3E2C19", "use": "deep bevels, plaque shadow" }
    },
    "ink": {
      "default":      { "hex": "#2A1E14", "use": "text on cream or tan. Never pure black." },
      "muted":        { "hex": "#6B5234", "use": "secondary text on cream or tan" },
      "onDark":       { "hex": "#F3E4C9", "use": "text on the navy ground" },
      "onDarkMuted":  { "hex": "#B9B2A4", "use": "secondary text on the navy ground" },
      "onButton":     { "hex": "#FFFFFF", "use": "button labels (neutral buttons use #FFF3E1)" },
      "plaque":       { "hex": "#F0D3A6", "use": "nameplate title text" },
      "win":          { "hex": "#1F7A22", "use": "gains, e.g. +250 NX" },
      "lose":         { "hex": "#B7271F", "use": "losses, e.g. -125 NX" }
    },
    "action": {
      "play":     { "face": "#FF3930", "lip": "#B7271F", "highlight": "#FF7A6E", "label": "#FFFFFF", "meaning": "start a match; at most one per screen" },
      "go":       { "face": "#2DA830", "lip": "#1B6E1E", "highlight": "#6ED36F", "label": "#FFFFFF", "meaning": "buy, claim, confirm, save, submit, OK, accept" },
      "info":     { "face": "#0051D5", "lip": "#00307F", "highlight": "#4D8CF0", "label": "#FFFFFF", "meaning": "share, invite, message, connect, info" },
      "option":   { "face": "#FCAB1E", "lip": "#B8720A", "highlight": "#FFD07A", "label": "#FFFFFF", "meaning": "open an option or sub-page, watch an ad, selected chip" },
      "neutral":  { "face": "#C09666", "lip": "#8A6A45", "highlight": "#DDBB8E", "label": "#FFF3E1", "meaning": "back, cancel, later, home, unselected chip" },
      "disabled": { "face": "#BDB3A3", "lip": "#8F8676", "highlight": "#D9D1C4", "label": "#F4EFE7", "meaning": "locked or unavailable" },
      "danger":   { "face": "#C62828", "lip": "#7F1616", "highlight": "#E35D5D", "label": "#FFFFFF", "meaning": "delete, remove, leave; only inside a confirm dialog" }
    },
    "house": {
      "red":    { "hex": "#E73735", "dark": "#9E1F1D", "board": "top-left" },
      "green":  { "hex": "#4DAE51", "dark": "#2E7A32", "board": "top-right" },
      "blue":   { "hex": "#1B89E7", "dark": "#0E5CA3", "board": "bottom-left" },
      "yellow": { "hex": "#FBC02B", "dark": "#C08F12", "board": "bottom-right" },
      "rule": "Player identity only (rings, seats, tokens, hero corners, result rows, confetti). Never a button colour."
    },
    "rarity": {
      "common":    { "hex": "#9A7148" },
      "rare":      { "hex": "#1B89E7" },
      "epic":      { "hex": "#8E44D6" },
      "legendary": { "hex": "#F2B51F", "rimGradient": ["#FFE9A6", "#F2B51F", "#B97F0B"] }
    },
    "rank": {
      "gold":   { "hex": "#E3A632" },
      "silver": { "hex": "#A9B1BB" },
      "bronze": { "hex": "#D0743C" },
      "other":  { "hex": "#C09666" },
      "self":   { "gradient": ["#8DB8E6", "#5B82AD"], "flag": "#2F5A86", "text": "#FFFFFF" }
    },
    "currency": {
      "coins":    { "icon": "item_coin", "use": "spendable soft currency; always icon first: [coin] 1,200" },
      "energy":   { "icon": "item_energy", "use": "match fuel; shown as 18/20" },
      "nxPoints": { "tagFill": "#9C0C33", "tagText": "#FFE3A3", "use": "score, never spendable; number then NX tag: 850 [NX]" }
    },
    "feedback": {
      "notifyDot": { "hex": "#FF3B30" },
      "progressFill": ["#FFD07A", "#FCAB1E", "#D9870C"]
    }
  },

  "font": {
    "display": { "family": "Lilita One", "file": "Assets/Fonts/LilitaOne-Regular.ttf" },
    "body":    { "family": "Nunito Bold", "file": "Assets/Fonts/Nunito-Bold.ttf" },
    "notForUI": ["Plus Jakarta Sans", "Baloo 2", "Titan One", "Assets/Fonts/Candidates/*"]
  },

  "type": {
    "heroNumber":   { "font": "display", "size": 44, "color": "#FFFFFF", "outline": "ink.default" },
    "plaqueTitle":  { "font": "display", "size": 22, "case": "upper", "color": "ink.plaque" },
    "panelHeading": { "font": "display", "size": 20, "case": "upper", "color": "ink.default" },
    "sectionLabel": { "font": "display", "size": 14, "case": "upper", "color": "ink.muted" },
    "rowTitle":     { "font": "display", "size": 17, "case": "title", "color": "ink.default" },
    "numberM":      { "font": "display", "size": 18 },
    "buttonXL":     { "font": "display", "size": 34, "case": "upper" },
    "buttonL":      { "font": "display", "size": 21, "case": "upper" },
    "buttonM":      { "font": "display", "size": 18, "case": "upper" },
    "buttonS":      { "font": "display", "size": 15, "case": "upper" },
    "body":         { "font": "body", "size": 14, "case": "sentence", "color": "ink.muted" },
    "caption":      { "font": "body", "size": 12, "case": "sentence", "color": "ink.muted" },
    "tag":          { "font": "display", "size": 12, "case": "upper", "color": "#FFFFFF" },
    "minimumReadable": 12,
    "minimumTag": 11
  },

  "space": { "unit": 4, "scale": [2, 4, 8, 12, 16, 20, 24, 32, 40, 48], "screenMargin": 16, "fieldPadding": 16, "cornerClearZone": 28, "rowGap": 8 },

  "size": {
    "panel":   { "popupWidth": 380, "hubWidth": 408, "rim": 10, "rimSmallCard": 6, "hubContentWidth": 356, "popupContentWidth": 328 },
    "shopCard": { "width": 112, "height": 158, "gap": 10, "perRow": 3 },
    "button":  { "xl": { "height": 66, "lip": 7 }, "l": { "height": 52, "lip": 6 }, "m": { "height": 46, "lip": 5 }, "s": { "height": 34, "lip": 4 }, "chip": { "height": 40, "lip": 4 }, "collar": 6 },
    "row":     { "list": [64, 74], "rank": [50, 56] },
    "tapTarget": 44,
    "closeX": 44,
    "closeXGap": 24,
    "avatar":  { "topBar": 52, "row": 36, "popupHero": 84 },
    "topBar":  { "height": 56 },
    "bottomNav": { "height": 116 }
  },

  "radius": { "panelOuter": 22, "panelField": 12, "cornerNotch": 24, "row": 14, "shopCardOuter": 16, "shopCardField": 11, "well": 12, "slab": 16, "pill": "height/2", "avatar": "circle" },

  "cornerDie": {
    "standard": { "body": "brown600", "pips": "cream100", "size": 17, "tilt": 16, "face": 6 },
    "hero":     { "bodies": { "topLeft": "house.red", "topRight": "house.green", "bottomLeft": "house.blue", "bottomRight": "house.yellow" }, "pips": "#FFFFFF", "bevel": "house.*.dark" },
    "smallCard": { "kind": "rivet", "diameter": 6.4, "color": "brown600" }
  },

  "elevation": {
    "E0_recessed": { "fill": "tan300", "innerShadow": { "x": 0, "y": 2.5, "blur": 2.5, "color": "#3C230A", "alpha": 0.45 } },
    "E1_resting":  { "lip": { "height": 2, "color": "tan300" }, "dropShadow": { "x": 0, "y": 2, "blur": 2, "color": "#3C2814", "alpha": 0.27 } },
    "E2_raised":   { "dropShadow": { "x": 0, "y": 10, "blur": 16, "color": "#000000", "alpha": 0.5 }, "litTopEdge": { "height": 1.4, "color": "#FFFFFF", "alpha": 0.65 } },
    "E3_floating": { "same": "E2_raised", "plus": "ground.scrim behind" },
    "panelField":  { "innerShadow": { "x": 0, "y": 3.5, "blur": 3.5, "color": "#462D14", "alpha": 0.37 }, "hairline": { "width": 0.9, "color": "tan400" } },
    "button":      { "faceGradient": "highlight at top -> face at 50%", "gloss": { "coverTop": 0.46, "alphaTop": 0.37, "alphaBottom": 0.05 }, "litTopEdge": { "height": 1.2, "alpha": 0.47 }, "labelOutline": "lip", "labelShadow": { "y": 1.4, "color": "lip" } },
    "pressed":     { "faceDropsBy": "lip - 1", "lipBecomes": 1, "darken": 0.11, "scale": 0.97, "ms": 80 },
    "linearColourSpace": "Pre-blend semi-transparent layers over known colours into opaque sprites. Shadows over varying backgrounds: alpha' = 1 - (1 - alpha)^2.2."
  },

  "motion": {
    "popupOpen":   { "scrimFadeMs": 180, "scale": [0.86, 1.04, 1.0], "ms": 260, "ease": "outBack" },
    "popupClose":  { "scale": [1.0, 0.92], "fade": true, "ms": 160, "ease": "inQuad" },
    "buttonPress": { "downMs": 80, "releaseMs": 140, "overshoot": 0.04 },
    "listStagger": { "perRowMs": 30, "slideUp": 12, "fadeMs": 180 },
    "countUp":     { "minMs": 600, "maxMs": 1200, "ease": "outCubic" },
    "playIdle":    { "scale": [1.0, 1.03], "periodMs": 1600, "rule": "only one idling element per screen" },
    "doors":       { "closeMs": 350, "openMs": 450, "use": "entering a match only" },
    "victory":     { "raysDegPerSec": 12, "confettiMs": 1500, "confettiColors": "house.*" }
  }
}
